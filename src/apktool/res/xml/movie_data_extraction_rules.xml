        <include domain="database" path="movie_local.db" />
        <include domain="file" path="profile_photos/" />
        <include domain="sharedpref" path="movie_profile_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="movie_local.db" />
        <include domain="file" path="profile_photos/" />
        <include domain="sharedpref" path="movie_profile_session.xml" />
    </device-transfer>
</data-extraction-rules>